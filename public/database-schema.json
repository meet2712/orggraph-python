    {
      "name": "benchmark_truth",
      "grain": "One answer derived from source labels",
      "definition": "CREATE VIEW benchmark_truth AS\nSELECT\n    company_id, employee_id, manager_employee_id,\n    canonical_title, canonical_department, canonical_team, canonical_level,\n    is_people_manager,\n    CASE WHEN manager_employee_id IS NULL THEN 1 ELSE 0 END AS is_root,\n    noise_profile_json\nFROM benchmark_labels;",
      "columns": [
        {
          "name": "company_id",
          "type": "TEXT",
          "required": false,
          "pk": 0,
          "fk": false
