          "type": "INTEGER",
          "required": false,
          "pk": 0,
          "fk": false
        },
        {
          "name": "is_root",
          "type": "",
          "required": false,
          "pk": 0,
          "fk": false
        },
        {
          "name": "noise_profile_json",
          "type": "TEXT",
          "required": false,
          "pk": 0,
          "fk": false
        }
      ]
    },
    {
      "name": "benchmark_comparison",
      "grain": "One live prediction-versus-label comparison",
      "definition": "CREATE VIEW benchmark_comparison AS\nSELECT\n    p.run_id, p.company_id, p.employee_id,\n    p.accepted_manager_id, p.confidence, p.decision,\n    b.manager_employee_id AS expected_manager_id,\n    CASE\n        WHEN b.employee_id IS NULL THEN 'unlabeled'\n        WHEN p.decision <> 'accepted' THEN 'not_accepted'\n        WHEN p.accepted_manager_id = b.manager_employee_id THEN 'correct'\n        ELSE 'incorrect'\n    END AS evaluation_status\nFROM reporting_predictions AS p\nLEFT JOIN benchmark_truth AS b USING (company_id, employee_id);",
      "columns": [
        {
          "name": "run_id",
          "type": "TEXT",
          "required": false,
          "pk": 0,
          "fk": false
        },
        {
          "name": "company_id",
          "type": "TEXT",
          "required": false,
          "pk": 0,
          "fk": false
        },
        {
          "name": "employee_id",
          "type": "TEXT",
          "required": false,
          "pk": 0,
          "fk": false
        },
        {
          "name": "accepted_manager_id",
          "type": "TEXT",
          "required": false,
          "pk": 0,
          "fk": false
        },
        {
          "name": "confidence",
          "type": "",
          "required": false,
          "pk": 0,
          "fk": false
        },
        {
          "name": "decision",
          "type": "",
          "required": false,
          "pk": 0,
          "fk": false
        },
        {
          "name": "expected_manager_id",
          "type": "TEXT",
          "required": false,
          "pk": 0,
          "fk": false
        },
        {
          "name": "evaluation_status",
          "type": "",
          "required": false,
          "pk": 0,
          "fk": false
        }
      ]
    },
    {
      "name": "company_profiles",
      "grain": "One live company profile",
      "definition": "CREATE VIEW company_profiles AS\nSELECT\n    c.company_id,\n    c.company_name,\n    c.industry,\n    CASE\n        WHEN count(e.employee_id) < 130 THEN 'Small'\n        WHEN count(e.employee_id) < 180 THEN 'Growth'\n        ELSE 'Mid-market'\n    END AS size_band,\n    count(e.employee_id) AS employee_count,\n    c.headquarters\nFROM companies AS c\nLEFT JOIN employees AS e USING (company_id)\nGROUP BY c.company_id, c.company_name, c.industry, c.headquarters;",
      "columns": [
        {
          "name": "company_id",
          "type": "TEXT",
          "required": false,
          "pk": 0,
          "fk": false
        },
        {
          "name": "company_name",
          "type": "TEXT",
          "required": false,
          "pk": 0,
          "fk": false
        },
        {
          "name": "industry",
          "type": "TEXT",
          "required": false,
          "pk": 0,
          "fk": false
        },
        {
          "name": "size_band",
          "type": "",
          "required": false,
          "pk": 0,
          "fk": false
        },
        {
          "name": "employee_count",
          "type": "",
          "required": false,
          "pk": 0,
          "fk": false
        },
        {
          "name": "headquarters",
          "type": "TEXT",
          "required": false,
          "pk": 0,
          "fk": false
        }
      ]
    },
    {
      "name": "employee_features",
      "grain": "One employee feature set per ready run",
      "definition": "CREATE VIEW employee_features AS\nSELECT\n    r.run_id,\n    e.company_id,\n    e.employee_id,\n    coalesce(o.inferred_department, 'Unclassified') AS inferred_department,\n    coalesce(o.inferred_level, 'Unknown') AS inferred_level,\n    coalesce(o.inferred_rank, 1) AS inferred_rank,\n    CASE WHEN o.employee_id IS NULL THEN 'pending_inference' ELSE 'processed' END AS processing_status\nFROM inference_runs AS r\nCROSS JOIN employees AS e\nLEFT JOIN inference_outputs AS o\n    ON o.run_id = r.run_id\n    AND o.company_id = e.company_id\n    AND o.employee_id = e.employee_id\nWHERE r.load_status = 'ready';",
      "columns": [
        {
          "name": "run_id",
          "type": "TEXT",
          "required": false,
          "pk": 0,
          "fk": false
        },
        {
          "name": "company_id",
          "type": "TEXT",
          "required": false,
          "pk": 0,
          "fk": false
        },
        {
          "name": "employee_id",
          "type": "TEXT",
          "required": false,
          "pk": 0,
          "fk": false
        },
        {
          "name": "inferred_department",
          "type": "",
          "required": false,
          "pk": 0,
          "fk": false
        },
        {
          "name": "inferred_level",
          "type": "",
          "required": false,
          "pk": 0,
          "fk": false
        },
        {
          "name": "inferred_rank",
          "type": "",
          "required": false,
          "pk": 0,
          "fk": false
        },
        {
          "name": "processing_status",
          "type": "",
          "required": false,
          "pk": 0,
          "fk": false
        }
      ]
    },
    {
      "name": "reporting_predictions",
      "grain": "One current decision per employee/ready run",
      "definition": "CREATE VIEW reporting_predictions AS\nSELECT\n    r.run_id,\n    e.company_id,\n    e.employee_id,\n    o.accepted_manager_id,\n    o.best_candidate_id,\n    coalesce(o.confidence, 0.0) AS confidence,\n    coalesce(o.margin, 0.0) AS margin,\n    coalesce(o.decision, 'pending_inference') AS decision\nFROM inference_runs AS r\nCROSS JOIN employees AS e\nLEFT JOIN inference_outputs AS o\n    ON o.run_id = r.run_id\n    AND o.company_id = e.company_id\n    AND o.employee_id = e.employee_id\nWHERE r.load_status = 'ready';",
      "columns": [
        {
          "name": "run_id",
          "type": "TEXT",
          "required": false,
          "pk": 0,
          "fk": false
        },
        {
          "name": "company_id",
          "type": "TEXT",
          "required": false,
          "pk": 0,
          "fk": false
        },
        {
          "name": "employee_id",
          "type": "TEXT",
          "required": false,
          "pk": 0,
          "fk": false
        },
        {
          "name": "accepted_manager_id",
          "type": "TEXT",
          "required": false,
          "pk": 0,
          "fk": false
        },
        {
          "name": "best_candidate_id",
          "type": "TEXT",
          "required": false,
          "pk": 0,
          "fk": false
        },
        {
          "name": "confidence",
          "type": "",
          "required": false,
          "pk": 0,
          "fk": false
        },
        {
          "name": "margin",
          "type": "",
          "required": false,
          "pk": 0,
          "fk": false
        },
        {
          "name": "decision",
          "type": "",
          "required": false,
          "pk": 0,
          "fk": false
        }
      ]
    },
    {
      "name": "prediction_reasons",
      "grain": "One explanation signal per decision",
      "definition": "CREATE VIEW prediction_reasons AS\nSELECT\n    o.run_id,\n    o.company_id,\n    o.employee_id,\n    reason.key AS position,\n    reason.value AS reason\nFROM inference_outputs AS o\nJOIN json_each(o.reasons_json) AS reason;",
      "columns": [
        {
          "name": "run_id",
          "type": "TEXT",
          "required": false,
          "pk": 0,
          "fk": false
        },
        {
          "name": "company_id",
          "type": "TEXT",
          "required": false,
          "pk": 0,
          "fk": false
        },
        {
          "name": "employee_id",
          "type": "TEXT",
          "required": false,
          "pk": 0,
          "fk": false
        },
        {
          "name": "position",
          "type": "BLOB",
          "required": false,
          "pk": 0,
          "fk": false
        },
        {
          "name": "reason",
          "type": "BLOB",
          "required": false,
          "pk": 0,
          "fk": false
        }
      ]
    },
    {
      "name": "employee_noise",
      "grain": "One generated noise label per employee",
      "definition": "CREATE VIEW employee_noise AS\nSELECT\n    t.company_id,\n    t.employee_id,\n    noise.key AS position,\n    noise.value AS noise_type\nFROM benchmark_truth AS t\nJOIN json_each(t.noise_profile_json) AS noise;",
      "columns": [
        {
          "name": "company_id",
          "type": "TEXT",
          "required": false,
          "pk": 0,
          "fk": false
        },
        {
          "name": "employee_id",
