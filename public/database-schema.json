        },
        {
          "name": "noise_type",
          "type": "BLOB",
          "required": false,
          "pk": 0,
          "fk": false
        }
      ]
    },
    {
      "name": "company_run_metrics",
      "grain": "One calculated company summary per ready run",
      "definition": "CREATE VIEW company_run_metrics AS\nWITH employee_metrics AS (\n    SELECT\n        p.run_id,\n        p.company_id,\n        sum(p.decision = 'accepted') AS resolved_count,\n        sum(p.decision IN ('unresolved', 'pending_inference')) AS unresolved_count,\n        1.0 * sum(p.decision = 'accepted') /\n            max(sum(p.decision <> 'company_root'), 1) AS coverage_raw,\n        coalesce(avg(CASE WHEN p.decision = 'accepted' THEN p.confidence END), 0.0)\n            AS average_confidence_raw\n    FROM reporting_predictions AS p\n    GROUP BY p.run_id, p.company_id\n), benchmark_metrics AS (\n    SELECT\n        run_id, company_id,\n        1.0 * sum(evaluation_status = 'correct') /\n            max(sum(evaluation_status IN ('correct', 'incorrect')), 1) AS precision_raw\n    FROM benchmark_comparison\n    GROUP BY run_id, company_id\n)\nSELECT\n    e.run_id,\n    e.company_id,\n    e.resolved_count,\n    e.unresolved_count,\n    cast(e.coverage_raw * 10000.0 + 0.5000000001 AS INTEGER) / 10000.0 AS coverage,\n    cast(b.precision_raw * 10000.0 + 0.5000000001 AS INTEGER) / 10000.0 AS precision,\n    cast(e.average_confidence_raw * 10000.0 + 0.5000000001 AS INTEGER) / 10000.0\n        AS average_confidence\nFROM employee_metrics AS e\nJOIN benchmark_metrics AS b USING (run_id, company_id);",
      "columns": [
        {
          "name": "run_id",
          "type": "TEXT",
          "required": false,
          "pk": 0,
          "fk": false
        },
        {
          "name": "company_id",
          "type": "TEXT",
          "required": false,
          "pk": 0,
          "fk": false
        },
        {
          "name": "resolved_count",
          "type": "",
          "required": false,
          "pk": 0,
          "fk": false
        },
        {
          "name": "unresolved_count",
          "type": "",
          "required": false,
          "pk": 0,
          "fk": false
        },
        {
          "name": "coverage",
          "type": "",
          "required": false,
          "pk": 0,
          "fk": false
        },
        {
          "name": "precision",
          "type": "",
          "required": false,
          "pk": 0,
          "fk": false
        },
        {
          "name": "average_confidence",
          "type": "",
          "required": false,
          "pk": 0,
          "fk": false
        }
      ]
    },
    {
      "name": "run_metrics",
      "grain": "One calculated summary per ready run",
      "definition": "CREATE VIEW run_metrics AS\nWITH run_totals AS (\n    SELECT\n        run_id,\n        count(DISTINCT company_id) AS company_count,\n        count(*) AS employee_count,\n        sum(decision = 'accepted') AS accepted_count,\n        sum(decision IN ('unresolved', 'pending_inference')) AS unresolved_count,\n        sum(decision = 'pending_inference') AS pending_inference_count,\n        coalesce(avg(CASE WHEN decision = 'accepted' THEN confidence END), 0.0)\n            AS average_resolved_confidence_raw\n    FROM reporting_predictions\n    GROUP BY run_id\n)\nSELECT\n    run_id,\n    company_count,\n    employee_count,\n    accepted_count,\n    unresolved_count,\n    pending_inference_count,\n    cast(average_resolved_confidence_raw * 10000.0 + 0.5000000001 AS INTEGER) / 10000.0\n        AS average_resolved_confidence\nFROM run_totals;",
      "columns": [
        {
          "name": "run_id",
          "type": "TEXT",
          "required": false,
          "pk": 0,
          "fk": false
        },
        {
          "name": "company_count",
          "type": "",
          "required": false,
          "pk": 0,
          "fk": false
        },
        {
          "name": "employee_count",
          "type": "",
          "required": false,
          "pk": 0,
          "fk": false
        },
        {
          "name": "accepted_count",
          "type": "",
          "required": false,
          "pk": 0,
          "fk": false
        },
        {
          "name": "unresolved_count",
          "type": "",
          "required": false,
          "pk": 0,
          "fk": false
        },
        {
          "name": "pending_inference_count",
          "type": "",
          "required": false,
          "pk": 0,
          "fk": false
        },
        {
          "name": "average_resolved_confidence",
          "type": "",
          "required": false,
          "pk": 0,
          "fk": false
        }
      ]
    },
    {
      "name": "employee_reporting_audit",
      "grain": "One inspectable decision per employee/ready run",
      "definition": "CREATE VIEW employee_reporting_audit AS\nSELECT\n    p.run_id, e.company_id, e.employee_id, e.full_name, e.job_title,\n    e.raw_department, e.raw_team, e.location,\n    f.inferred_department, f.inferred_level, f.processing_status,\n    p.accepted_manager_id, manager.full_name AS inferred_manager,\n    p.best_candidate_id, candidate.full_name AS leading_candidate,\n    p.confidence, p.margin, p.decision,\n    r.probability_threshold, r.margin_threshold,\n    CASE\n        WHEN p.decision = 'pending_inference' THEN 'pending_inference'\n        WHEN p.decision = 'company_root' THEN 'observed_ceo_title'\n        WHEN p.decision = 'accepted' THEN 'cleared_both_checks'\n        WHEN p.best_candidate_id IS NULL THEN 'no_suitable_candidate'\n        WHEN p.confidence < r.probability_threshold AND p.margin < r.margin_threshold\n            THEN 'low_confidence_and_ambiguous_candidates'\n        WHEN p.confidence < r.probability_threshold THEN 'low_confidence'\n        WHEN p.margin < r.margin_threshold THEN 'ambiguous_candidates'\n        ELSE 'unresolved'\n    END AS decision_reason,\n    r.source_hash, r.model_version, r.pipeline_version\nFROM reporting_predictions AS p\nJOIN inference_runs AS r USING (run_id)\nJOIN employees AS e USING (company_id, employee_id)\nJOIN employee_features AS f USING (run_id, company_id, employee_id)\nLEFT JOIN employees AS manager\n    ON manager.company_id = p.company_id AND manager.employee_id = p.accepted_manager_id\nLEFT JOIN employees AS candidate\n    ON candidate.company_id = p.company_id AND candidate.employee_id = p.best_candidate_id;",
